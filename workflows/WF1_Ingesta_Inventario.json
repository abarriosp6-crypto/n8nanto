        {
            "parameters": {
                "operation": "executeQuery",
                "query": "INSERT INTO productos (sku, nombre, categoria, stock_actual, stock_minimo, fecha_vencimiento)\nVALUES (\n  '{{ $json.sku }}',\n  '{{ $json.nombre }}',\n  '{{ $json.categoria }}',\n  {{ $json.cantidad }},\n  {{ $json.stock_minimo }},\n  {{ $json.fecha_vencimiento ? \"'\" + $json.fecha_vencimiento + \"'\" : 'NULL' }}\n)\nON CONFLICT (sku) DO UPDATE SET\n  stock_actual = productos.stock_actual + EXCLUDED.stock_actual,\n  stock_minimo = CASE WHEN EXCLUDED.stock_minimo > 0 THEN EXCLUDED.stock_minimo ELSE productos.stock_minimo END,\n  updated_at = now()\nRETURNING id, sku, stock_actual;",
                "options": {}
            },
            "id": "pg-upsert-producto-entrada",
