        {
            "parameters": {
                "operation": "executeQuery",
                "query": "WITH upd AS (\n  UPDATE productos SET\n    stock_actual = stock_actual - {{ $('Normalizar Campos').item.json.cantidad }},\n    updated_at = now()\n  WHERE id = '{{ $json.id }}'\n  RETURNING id\n)\nINSERT INTO salidas (producto_id, tipo_salida, destinatario, cantidad, precio_unitario, origen, referencia, fecha_salida)\nVALUES (\n  '{{ $json.id }}',\n  '{{ $('Normalizar Campos').item.json.tipo_salida }}',\n  {{ $('Normalizar Campos').item.json.destinatario ? \"'\" + $('Normalizar Campos').item.json.destinatario + \"'\" : 'NULL' }},\n  {{ $('Normalizar Campos').item.json.cantidad }},\n  {{ $('Normalizar Campos').item.json.precio_unitario }},\n  'WEBHOOK',\n  {{ $('Normalizar Campos').item.json.referencia ? \"'\" + $('Normalizar Campos').item.json.referencia + \"'\" : 'NULL' }},\n  CURRENT_DATE\n)\nRETURNING id;",
                "options": {}
